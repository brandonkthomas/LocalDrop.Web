{
  "name": "localdrop-web-client",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild wwwroot/ts/localdrop.ts --bundle --format=esm --outfile=wwwroot/dist/js/localdrop.js --log-level=warning",
    "test:protocol": "mkdir -p .tmp && esbuild tests/protocol.test.ts --bundle --platform=node --format=esm --outfile=.tmp/protocol.test.mjs --log-level=warning && node .tmp/protocol.test.mjs"
  },
  "dependencies": {
    "@foxglove/crc": "^1.0.1",
    "jsqr": "^1.4.0",
    "qr": "^0.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
