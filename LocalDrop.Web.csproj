<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <StaticWebAssetBasePath>apps/localdrop</StaticWebAssetBasePath>

        <IndiumProjectPath Condition="'$(IndiumProjectPath)' == '' and Exists('$(MSBuildProjectDirectory)/../../Libraries/Indium/Indium.csproj')">$(MSBuildProjectDirectory)/../../Libraries/Indium/Indium.csproj</IndiumProjectPath>
        <IndiumProjectPath Condition="'$(IndiumProjectPath)' == ''">$(MSBuildProjectDirectory)/../Submodules/Indium/Indium.csproj</IndiumProjectPath>
        <RootNamespace>LocalDrop.Web</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="$(IndiumProjectPath)" Condition="Exists('$(IndiumProjectPath)')" />
    </ItemGroup>

    <ItemGroup>
        <None Update="package.json;package-lock.json;tsconfig.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
        <Content Update="package.json;package-lock.json;tsconfig.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <Target Name="BuildLocalDropClient" BeforeTargets="Build">
        <PropertyGroup>
            <_LocalDropEntryTs>$(MSBuildProjectDirectory)/wwwroot/ts/localdrop.ts</_LocalDropEntryTs>
            <_LocalDropOutDir>$(MSBuildProjectDirectory)/wwwroot/dist/js</_LocalDropOutDir>
            <_LocalDropOutFile>$(_LocalDropOutDir)/localdrop.js</_LocalDropOutFile>
            <_EsbuildCliLocal>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/node_modules/esbuild/bin/esbuild'))</_EsbuildCliLocal>
            <_EsbuildCliPortfolio>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Portfolio/node_modules/esbuild/bin/esbuild'))</_EsbuildCliPortfolio>
            <_EsbuildCli Condition="'$(EsbuildCli)' != ''">$(EsbuildCli)</_EsbuildCli>
            <_EsbuildCli Condition="'$(_EsbuildCli)' == '' and Exists('$(_EsbuildCliLocal)')">$(_EsbuildCliLocal)</_EsbuildCli>
            <_EsbuildCli Condition="'$(_EsbuildCli)' == '' and Exists('$(_EsbuildCliPortfolio)')">$(_EsbuildCliPortfolio)</_EsbuildCli>
        </PropertyGroup>

        <Error Condition="'$(_EsbuildCli)' == ''" Text="Missing esbuild CLI. Pass EsbuildCli from a host build or install dependencies in LocalDrop.Web or Portfolio." />

        <MakeDir Directories="$(_LocalDropOutDir)" />

        <Exec
                Condition="Exists('$(_LocalDropEntryTs)')"
                Command="&quot;$(_EsbuildCli)&quot; &quot;$(_LocalDropEntryTs)&quot; --bundle --format=esm --outfile=&quot;$(_LocalDropOutFile)&quot; --log-level=warning" />
    </Target>

</Project>
