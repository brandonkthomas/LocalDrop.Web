@{
    ViewData["Title"] = "LocalDrop";
}

<section class="bb-page" data-bb-app>
    <div class="glass-surface glass-surface--fallback bb-card" role="region" aria-label="LocalDrop">
        <div class="glass-surface__content bb-card-content">
            <header class="bb-header">
                <div class="bb-title">
                    <span>LocalDrop</span>
                </div>
                <p class="bb-subtitle">Share files through QR codes, fully offline.</p>
                <div class="bb-runtime" aria-live="polite" data-bb-runtime-status hidden>Offline client</div>
            </header>

            <div class="bb-switchbar" aria-label="Mode selectors">
                <div class="bb-toggle-pair" aria-label="Send or receive">
                    <span>Send</span>
                    <label class="comp-toggle bb-toggle">
                        <input type="checkbox" class="comp-toggle-input" data-bb-mode-toggle aria-label="Switch between send and receive" />
                        <span class="comp-toggle-track comp-toggle-large" aria-hidden="true">
                            <span class="comp-toggle-thumb"></span>
                        </span>
                    </label>
                    <span>Receive</span>
                </div>
            </div>

            <main class="bb-workspace">
                <section class="bb-pane bb-pane--send" data-bb-send-panel>
                    <div class="bb-input-panel" data-bb-input-panel>
                        <div class="bb-compose">
                            <div class="bb-field bb-field--text bb-input-surface" data-bb-text-field>
                                <textarea data-bb-text-input spellcheck="true" placeholder="Paste text here"></textarea>
                            </div>

                            <div class="bb-field bb-field--file bb-input-surface" data-bb-file-field hidden>
                                <input data-bb-file-input id="bb-file-input" type="file" hidden />
                                <label class="bb-dropzone" for="bb-file-input" data-bb-dropzone>
                                    <span class="bb-dropzone__title">Choose file</span>
                                    <span class="bb-dropzone__meta" data-bb-file-meta>No file selected</span>
                                </label>
                            </div>

                            <button type="button" class="wa-btn bb-content-toggle" data-bb-content-toggle aria-label="Switch to file upload">
                                <img data-bb-content-toggle-icon src="~/apps/indium/assets/svg/paper-clip.svg" asp-append-version="true" alt="" aria-hidden="true" />
                                <span data-bb-content-toggle-label>Upload...</span>
                            </button>
                        </div>

                    </div>

                    <div class="bb-qr-stage" data-bb-qr-stage hidden>
                        <div class="bb-qr-wrap">
                            <canvas data-bb-qr-canvas width="720" height="720" aria-label="LocalDrop QR code"></canvas>
                        </div>

                        <div class="bb-transfer-meta">
                            <div>
                                <span data-bb-frame-label>Frame 0 of 0</span>
                                <span data-bb-frame-kind></span>
                            </div>
                            <div data-bb-transfer-size></div>
                        </div>

                        <div class="bb-player-controls" aria-label="Transfer controls">
                            <button type="button" class="wa-btn wa-btn--icon" data-bb-prev aria-label="Previous frame" title="Previous frame">
                                <span aria-hidden="true">&lt;</span>
                            </button>
                            <button type="button" class="wa-btn wa-btn--primary" data-bb-play>Begin</button>
                            <button type="button" class="wa-btn wa-btn--icon" data-bb-next aria-label="Next frame" title="Next frame">
                                <span aria-hidden="true">&gt;</span>
                            </button>
                        </div>
                    </div>
                </section>

                <section class="bb-pane bb-pane--receive" data-bb-receive-panel hidden>
                    <div class="bb-receiver-grid">
                        <div class="bb-video-frame">
                            <video data-bb-video playsinline muted></video>
                            <canvas data-bb-scan-canvas hidden></canvas>
                        </div>

                        <div class="bb-receive-panel">
                            <div class="bb-receive-actions">
                                <button type="button" class="wa-btn wa-btn--primary" data-bb-start-camera>Start Camera</button>
                                <button type="button" class="wa-btn" data-bb-stop-camera disabled>Stop</button>
                            </div>

                            <dl class="bb-stats">
                                <div>
                                    <dt>Transfer</dt>
                                    <dd data-bb-receive-transfer>Waiting</dd>
                                </div>
                                <div>
                                    <dt>Progress</dt>
                                    <dd data-bb-receive-progress>0 / 0</dd>
                                </div>
                            </dl>

                            <div class="bb-status" data-bb-receive-status aria-live="polite">Camera idle.</div>

                            <div class="bb-result" data-bb-result hidden>
                                <textarea data-bb-result-text readonly hidden></textarea>
                                <a class="wa-btn wa-btn--primary" data-bb-download hidden>Download</a>
                                <button type="button" class="wa-btn" data-bb-copy hidden>Copy Text</button>
                                <button type="button" class="wa-btn" data-bb-reset-receiver>Reset</button>
                            </div>
                        </div>
                    </div>
                </section>
            </main>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/apps/indium/dist/components/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/toggleSwitch.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/apps/localdrop/css/localdrop.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/apps/localdrop/dist/js/localdrop.js" type="module" asp-append-version="true"></script>
}
